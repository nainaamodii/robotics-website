# ───────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev (never commit the filled-in copy — .env* is
# gitignored on purpose). For GitHub Actions / hosting, put these in
# Settings → Secrets and variables → Actions, or your host's env settings.
# ───────────────────────────────────────────────────────────────────────────

# ── Required ──
MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB_NAME=robotics-club

# Session signing key, >= 32 chars:  openssl rand -hex 32
# It also derives the key that encrypts the SMTP password stored in MongoDB.
JWT_SECRET=

# Admin console password, >= 8 chars
ADMIN_PASSWORD=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ── Site URL ──
# Public origin. Google's redirect URI is built from it, so it must match
# Google Cloud Console exactly. Defaults to http://localhost:3000 in dev.
APP_URL=http://localhost:3000

# ── Sign-in policy ──
# Only addresses at this domain can sign in (email OTP and Google). Empty = anyone.
ALLOWED_EMAIL_DOMAIN=mnnit.ac.in

# ── Google sign-in (optional) ──
# Shown on the sign-in page only when BOTH are set. In Google Cloud Console →
# Credentials → OAuth client (Web), add these Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-production-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Email: there are NO SMTP env vars. Sign-in codes are sent with the SMTP
# credentials saved under  Admin → Email / SMTP  (encrypted in MongoDB).
